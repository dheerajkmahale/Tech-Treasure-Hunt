# ==============================================================================
# TECH TREASURE HUNT — ENVIRONMENT VARIABLES SPECIFICATION
# ==============================================================================
# Never commit real passwords, tokens, or connection strings to GitHub.
# Place real secrets only in Render and Vercel environment settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER (BACKEND WEB SERVICE)
# Configure these in the Render Dashboard -> Environment -> Environment Variables
# ------------------------------------------------------------------------------
# PostgreSQL connection string provided by Render PostgreSQL (Internal or External URL)
DATABASE_URL=postgresql://user:password@host:5432/tech_treasure_hunt

# Production environment flag (enables SSL and secure cross-origin cookies)
NODE_ENV=production

# Frontend origin URL for CORS validation (use comma-separated for preview branches)
CLIENT_URL=https://tech-treasure-hunt-drab.vercel.app

# Strong secret key for signing player session JWT tokens (min 32 characters)
JWT_SECRET=replace_with_a_long_random_jwt_secret_min_32_chars

# Optional port (Render injects PORT automatically; default is 5000)
PORT=5000

# Game & event configuration
DEFAULT_EVENT_DURATION_MINUTES=70
FOCUS_VIOLATION_LIMIT=3
COINS_PER_CORRECT_ANSWER=10
LEVEL_COMPLETION_BONUS=25
GEMS_PER_LEVEL=1

# Optional organizer credentials created by seeding
ORGANIZER_NAME=Event Organizer
ORGANIZER_EMAIL=organizer@example.com
ORGANIZER_PASSWORD=replace_with_secure_organizer_password

# Optional AI evaluation and code runner keys (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CODE_RUNNER_URL=
CODE_RUNNER_API_KEY=

# ------------------------------------------------------------------------------
# 2. VERCEL (FRONTEND VITE APPLICATION)
# Configure these in Vercel Project Settings -> Environment Variables
# Selected for: Production, Preview, and Development
# ------------------------------------------------------------------------------
# Public backend API origin (used by the browser to reach Render backend)
VITE_API_URL=https://tech-treasure-hunt-laq9.onrender.com

# ------------------------------------------------------------------------------
# 3. LOCAL DEVELOPMENT (.env placed in project root)
# ------------------------------------------------------------------------------
# PORT=5000
# NODE_ENV=development
# CLIENT_URL=http://localhost:5173
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tech_treasure_hunt
# JWT_SECRET=local_dev_secret_key_at_least_32_characters_long
