# API
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL - create this database before running migrations
DATABASE_URL=postgresql://postgres:local_dev_password@localhost:5432/tech_treasure_hunt

# Authentication (replace with long random values before deployment)
JWT_SECRET=replace_with_a_long_random_secret
COOKIE_SECRET=replace_with_a_different_long_random_secret

# OpenAI (server-side only; do not use VITE_ prefix)
OPENAI_API_KEY=
OPENAI_MODEL=

# Isolated code runner - do not execute untrusted code in Express
CODE_RUNNER_URL=
CODE_RUNNER_API_KEY=

DEFAULT_EVENT_DURATION_MINUTES=70
MAX_TEAM_SIZE=5
MAX_TEAMS=20

# Optional organizer account created by npm run db:seed
ORGANIZER_NAME=Event Organizer
ORGANIZER_EMAIL=
ORGANIZER_PASSWORD=

# Focus rules (unique incidents only; browsers cannot fully lock a device)
FOCUS_VIOLATION_LIMIT=3
COINS_PER_CORRECT_ANSWER=10
LEVEL_COMPLETION_BONUS=25
GEMS_PER_LEVEL=1
